# ==============================================================================
# REPLYZA PRODUCTION ENVIRONMENT TEMPLATE (/etc/replyza.env)
# ==============================================================================
# Set file permissions strictly to 0600 (owner: replyza:replyza)
# chmod 600 /etc/replyza.env
# chown replyza:replyza /etc/replyza.env

NODE_ENV=production
PORT=4000

# Canonical Public Domain Names (Strict HTTPS, No Trailing Slashes)
FRONTEND_URL=https://replyza.buzz
INTERNAL_API_URL=http://127.0.0.1:4000

# Shared Secret between Next.js Proxy Route and Express API Server
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PROXY_SHARED_SECRET=GENERATE_SECURE_RANDOM_SECRET_AT_LEAST_32_CHARS

# ------------------------------------------------------------------------------
# SUPABASE POSTGRESQL CONFIGURATION
# ------------------------------------------------------------------------------
# DATABASE_URL: Connects through Supabase Transaction Pooler (Port 6543)
# Append '?pgbouncer=true&connection_limit=10' for optimal worker/API pooling
DATABASE_URL=postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10

# DIRECT_URL: Connects through Supabase Session Pooler (Port 5432) for Prisma Migrations
DIRECT_URL=postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:5432/postgres

# ------------------------------------------------------------------------------
# REDIS CONFIGURATION (BullMQ Queue)
# ------------------------------------------------------------------------------
# Local Redis on the same EC2 instance (bind 127.0.0.1)
REDIS_URL=redis://127.0.0.1:6379

# ------------------------------------------------------------------------------
# CRYPTOGRAPHIC SECRETS (32+ Character Random Strings)
# ------------------------------------------------------------------------------
# Generate each via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=GENERATE_SECURE_RANDOM_SECRET_AT_LEAST_32_CHARS
SESSION_SECRET=GENERATE_SECURE_RANDOM_SECRET_AT_LEAST_32_CHARS

# 64-character hexadecimal key for AES-256-GCM token encryption
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
META_TOKEN_ENCRYPTION_KEY=GENERATE_64_CHARACTER_HEXADECIMAL_KEY_HERE

# ------------------------------------------------------------------------------
# META / INSTAGRAM GRAPH API CONFIGURATION
# ------------------------------------------------------------------------------
# Meta App Dashboard: https://developers.facebook.com/apps
META_APP_ID=YOUR_META_APP_ID
META_APP_SECRET=YOUR_META_APP_SECRET_MIN_32_CHARS
META_WEBHOOK_VERIFY_TOKEN=GENERATE_SECURE_RANDOM_VERIFY_TOKEN_MIN_32_CHARS
META_LOGIN_CONFIG_ID=YOUR_FACEBOOK_LOGIN_FOR_BUSINESS_CONFIG_ID
META_REDIRECT_URI=https://api.replyza.buzz/api/v1/instagram/oauth/callback
META_GRAPH_API_VERSION=v27.0

# ------------------------------------------------------------------------------
# FEATURE FLAGS (Default to true, set to false to disable)
# ------------------------------------------------------------------------------
ENABLE_MEDIA_LIBRARY=true
ENABLE_FOLLOW_GATE=true
ENABLE_TEMPLATES=true
ENABLE_NEW_BUILDER=true
