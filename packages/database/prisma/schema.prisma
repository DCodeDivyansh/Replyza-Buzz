
generator client {
  provider = "prisma-client"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String   @id @default(uuid()) @db.Uuid
  email             String   @unique
  passwordHash      String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  instagramAccounts InstagramAccount[]
  refreshTokens RefreshToken[]
  automationTemplates AutomationTemplate[]
  affiliateProducts AffiliateProduct[]
  affiliateIntegrations AffiliateIntegration[]

  @@map("users")
}

enum AffiliateProvider {
  CUELINKS
}

model AffiliateIntegration {
  id              String            @id @default(uuid()) @db.Uuid
  userId          String            @db.Uuid
  provider        AffiliateProvider
  publisherId     String
  apiKeyEncrypted String?
  isEnabled       Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
  @@map("affiliate_integrations")
}

enum InstagramAccountStatus {
  ACTIVE
  NEEDS_RECONNECT
}

model InstagramAccount {
  id                       String                  @id @default(uuid()) @db.Uuid
  userId                   String                  @db.Uuid
  instagramUserId          String                  @unique
  username                 String?
  encryptedAccessToken     String
  tokenExpiresAt           DateTime?
  status                   InstagramAccountStatus  @default(ACTIVE)
  webhookSubscribed        Boolean                 @default(false)
  webhookSubscribedAt      DateTime?
  webhookSubscriptionError String?
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  automations   Automation[]
  webhookEvents WebhookEvent[]
  messagingEvents MessagingWebhookEvent[]

  @@index([userId])
  @@map("instagram_accounts")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique
  familyId  String   @db.Uuid
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}



enum AutomationTrigger {
  ANY_COMMENT
  KEYWORD
}

enum AutomationStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  EXPIRED
}

enum TargetMode {
  SPECIFIC_POST
  ALL_POSTS
  NEXT_POST
  SCHEDULED_TIME
}

enum MediaTypeFilter {
  ANY
  REELS
  FEED
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
}

enum ExecutionStatus {
  PENDING
  PROCESSING
  RETRY_PENDING
  COMPLETED
  PARTIAL
  FAILED
  CANCELLED
}

enum ActionStatus {
  PENDING
  PROCESSING
  RETRY_PENDING
  SUCCESS
  FAILED
  UNKNOWN
  SKIPPED
  CANCELLED
}

enum OutboxStatus {
  PENDING
  DISPATCHED
  FAILED
}

enum KeywordMatchMode {
  CONTAINS
  EXACT
  ANY
}

enum KeywordMatchLogic {
  ANY_KEYWORD
  ALL_KEYWORDS
}

enum ProductDeliveryMode {
  SINGLE_MESSAGE
  SEPARATE_MESSAGES
  GENERIC_CARDS
  SELECTION_PROMPT
}

enum ProductStatus {
  ACTIVE
  ARCHIVED
}

enum DeliveryMode {
  DIRECT
  BUTTON
}

enum DeliveryActionType {
  PUBLIC_REPLY
  HOOK_DM
  LINK_DM
  FOLLOW_FALLBACK_DM
}

enum DeliveryActionStatus {
  PENDING
  SENDING
  SENT
  FAILED
  SKIPPED
  NEEDS_REVIEW
}

enum ConversationState {
  HOOK_SENT
  AWAITING_TAP
  TAPPED
  FOLLOW_CHECKING
  AWAITING_FOLLOW
  COMPLETED
  EXPIRED_WINDOW
  FAILED
  NEEDS_RECONNECT
}

model Automation {
  id                 String            @id @default(uuid()) @db.Uuid
  instagramAccountId String            @db.Uuid

  name               String
  targetMode         TargetMode        @default(SPECIFIC_POST)
  mediaId            String?
  mediaPermalink     String?
  mediaType          String?
  scheduledActivateAt DateTime?
  bindingWindowEndAt  DateTime?
  mediaTypeFilter    MediaTypeFilter   @default(ANY)
  captionKeywordFilter String?

  triggerType        AutomationTrigger
  keywordMatchMode   KeywordMatchMode  @default(CONTAINS)
  keywordMatchLogic  KeywordMatchLogic @default(ANY_KEYWORD)
  keywords           String[]          @default([])

  publicReplyEnabled    Boolean        @default(true)
  publicReplyText       String
  publicReplyVariations String[]       @default([])
  dmMessageText         String
  dmLink                String?

  productDeliveryMode   ProductDeliveryMode @default(SINGLE_MESSAGE)
  productIntroText      String?
  productClosingText    String?

  deliveryMode          DeliveryMode      @default(DIRECT)
  buttonLabel           String?
  cooldownSeconds       Int               @default(0)
  dmMeFallbackEnabled   Boolean           @default(false)

  followRequired        Boolean           @default(false)
  followInstructionText String?
  followSuccessText     String?
  followFallbackText    String?
  followUpEnabled       Boolean           @default(false)
  followUpText          String?
  templateId            String?           @db.Uuid

  status             AutomationStatus  @default(DRAFT)

  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  instagramAccount   InstagramAccount    @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  template           AutomationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  executions         AutomationExecution[]
  products           AutomationProduct[]

  @@index([instagramAccountId, mediaId])
  @@index([instagramAccountId, status])
  @@index([instagramAccountId, status, targetMode])
  @@map("automations")
}

model WebhookEvent {
  id                    String             @id @default(uuid()) @db.Uuid
  instagramAccountId    String             @db.Uuid

  commentId             String
  mediaId               String
  commenterInstagramId  String
  commenterUsername     String?
  commentText           String

  eventPayload          Json
  status                WebhookEventStatus @default(RECEIVED)

  receivedAt            DateTime           @default(now())
  processedAt           DateTime?

  instagramAccount      InstagramAccount   @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  execution             AutomationExecution?

  @@unique([instagramAccountId, commentId])
  @@index([status, receivedAt])
  @@index([mediaId])
  @@map("webhook_events")
}

model AutomationExecution {
  id                 String          @id @default(uuid()) @db.Uuid
  automationId       String          @db.Uuid
  webhookEventId     String          @unique @db.Uuid

  status             ExecutionStatus @default(PENDING)

  publicReplyStatus  ActionStatus    @default(PENDING)
  privateReplyStatus ActionStatus    @default(PENDING)

  metaReplyId        String?
  metaPrivateReplyId String?

  errorMessage       String?

  startedAt          DateTime?
  leaseExpiresAt     DateTime?
  leaseToken         String?         @db.Uuid
  completedAt        DateTime?
  createdAt          DateTime        @default(now())

  retryCount                Int             @default(0)
  lastAttemptAt             DateTime?

  followCheckStatus         ActionStatus?      @default(PENDING)
  followCheckSentAt         DateTime?
  followCheckVerifiedAt     DateTime?
  followCheckRetryCount     Int                @default(0)
  metaFollowCheckReplyId    String?
  followVerificationOutcome String?
  followCheckError          String?

  conversationState         ConversationState?
  commenterIgsid            String?
  tapEventMid               String?            @unique

  automation         Automation      @relation(fields: [automationId], references: [id], onDelete: Cascade)
  webhookEvent       WebhookEvent    @relation(fields: [webhookEventId], references: [id], onDelete: Cascade)
  messagingEvents    MessagingWebhookEvent[]
  deliveryActions    DeliveryAction[]

  @@index([automationId, createdAt])
  @@index([commenterIgsid, createdAt])
  @@index([status])
  @@map("automation_executions")
}

model DeliveryAction {
  id               String               @id @default(uuid()) @db.Uuid
  executionId      String               @db.Uuid
  actionType       DeliveryActionType
  status           DeliveryActionStatus @default(PENDING)
  metaId           String?
  attempts         Int                  @default(0)
  lastErrorCode    String?
  lastErrorMessage String?
  sentAt           DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  execution AutomationExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@unique([executionId, actionType])
  @@index([status, createdAt])
  @@map("delivery_actions")
}

model OutboxEvent {
  id            String       @id @default(uuid()) @db.Uuid
  eventType     String
  aggregateId   String
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  nextAttemptAt DateTime     @default(now())
  dispatchedAt  DateTime?
  lastError     String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([eventType, aggregateId])
  @@index([status, nextAttemptAt])
  @@map("outbox_events")
}

model MessagingWebhookEvent {
  id                 String             @id @default(uuid()) @db.Uuid
  instagramAccountId String             @db.Uuid
  providerEventId    String
  senderId           String
  recipientId        String
  payload            String?
  executionId        String?            @db.Uuid
  status             WebhookEventStatus @default(RECEIVED)
  rawPayload         Json?
  receivedAt         DateTime           @default(now())
  processedAt        DateTime?

  instagramAccount   InstagramAccount    @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  execution          AutomationExecution? @relation(fields: [executionId], references: [id], onDelete: SetNull)

  @@unique([instagramAccountId, providerEventId])
  @@index([executionId])
  @@index([status, receivedAt])
  @@map("messaging_webhook_events")
}

model AutomationTemplate {
  id                    String            @id @default(uuid()) @db.Uuid
  userId                String?           @db.Uuid
  name                  String
  category              String
  description           String?
  triggerType           AutomationTrigger @default(KEYWORD)
  keywords              String[]          @default([])
  publicReplyText       String
  dmMessageText         String
  dmLink                String?
  followRequired        Boolean           @default(false)
  followInstructionText String?
  followSuccessText     String?
  followFallbackText    String?
  isSystem              Boolean           @default(false)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  user                  User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  automations           Automation[]

  @@index([userId])
  @@index([isSystem])
  @@map("automation_templates")
}

model AffiliateProduct {
  id               String        @id @default(uuid()) @db.Uuid
  userId           String        @db.Uuid
  name             String
  brand            String?
  description      String?
  imageUrl         String?
  affiliateUrl     String
  originalUrl      String?
  price            String?
  discountPrice    String?
  discountInfo     String?
  couponCode       String?
  affiliatePartner String?
  category         String?
  ctaLabel         String        @default("Shop Now")
  notes            String?
  status           ProductStatus @default(ACTIVE)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  automationProducts AutomationProduct[]

  @@index([userId, status])
  @@index([userId, category])
  @@index([userId, brand])
  @@map("affiliate_products")
}

model AutomationProduct {
  id                 String   @id @default(uuid()) @db.Uuid
  automationId       String   @db.Uuid
  affiliateProductId String?  @db.Uuid
  name               String
  imageUrl           String?
  description        String?
  productUrl         String?
  affiliateUrl       String
  originalUrl        String?
  price              String?
  discountPrice      String?
  category           String?
  ctaLabel           String   @default("Shop Now")
  customMessage      String?
  couponCode         String?
  brand              String?
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  automation       Automation        @relation(fields: [automationId], references: [id], onDelete: Cascade)
  affiliateProduct AffiliateProduct? @relation(fields: [affiliateProductId], references: [id], onDelete: SetNull)

  @@index([automationId, sortOrder])
  @@map("automation_products")
}
